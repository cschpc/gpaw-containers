Bootstrap: docker
From: satama.csc.fi/r_installation_spack/core-cpu-gcc-15.2.0:v2026_03

%arguments
    PYTHON_VER=3.14.10
    BASEDIR=/gpaw_container
    CONFIG_DIR={{ BASEDIR }}/config
    ENV_SCRIPT=/opt/gpaw_deps_env.sh
    # Where the spack view will be created. Keep in sync with config/spack.yaml.
    # This will be shown in "gpaw info"
    VIEW_DIR={{ BASEDIR }}/view

%files
    # Container is rocky9 but we treat it as rhel9: lets Spack do better job at reusing upstream packages. OK because these are ABI compatible
    ../common/rhel9-os-release /etc/os-release
    # Custom Spack recipe for Python: adds 3.14.10 (eMudhra CA hotfix) and fixes configure flags for tk module
    ../common/python_spack_package.py {{ CONFIG_DIR }}/python_spack_package.py

    # Copy Spack config: should instruct Spack to reuse upstream packages whenever possible
    config/spack.yaml {{ CONFIG_DIR }}/spack.yaml

%post
    mkdir -p /users

    # Spack prerequisites
    dnf install --assumeyes epel-release
    dnf install --assumeyes file bzip2 ca-certificates git gzip patch python3 tar unzip xz zstd gdb which
    dnf install --assumeyes autoconf automake libtool m4
    dnf install --assumeyes tcl-devel tk-devel
    dnf clean all

    cd {{ BASEDIR }}
    # Use the same (or almost same) version of spack and spack-packages as used when the Roihu stack was built.
    # Otherwise can run in nasty issues where Spack would install a separate GCC runtime due to eg. compiler-wrapper version being different.
    git clone --depth 1 -b csc/v1.1 https://github.com/CSCfi/spack.git
    . spack/share/spack/setup-env.sh

    # Create a spack environment using our copied spack config and make the env aware of packages installed in the base container
    source spack/share/spack/setup-env.sh
    upstream=gcc152_ec
    spack env create environments/gpaw_deps {{ CONFIG_DIR }}/spack.yaml
    spack env activate -p environments/gpaw_deps

    spack config add upstreams:${upstream}:install_tree:/appl/soft/spack/core/v2026_03/x86_64/${upstream}/install_dir
    spack config add config:source_cache:source-cache

    # Configure external packages
    spack external find pkgconf pkg-config git
    # Spack autotools builder __sometimes__ needs these => hard to test since it doesn't fail every time! Unsure if this fixes anything:
    spack external find autoconf automake libtool
    # Configure specs for external tcl, tk. Use Spack's file-merge (-f) instead of fighting `spack config add ...` syntax
    TCL_VERSION=$(rpm -q --qf '%{VERSION}' tcl)
    cat > /tmp/tcl_tk_packages.yaml << EOF
packages:
  tcl:
    buildable: false
    externals:
    - spec: tcl@${TCL_VERSION}
      prefix: /usr
  tk:
    buildable: false
    externals:
    - spec: tk@${TCL_VERSION}+xft+xss ^tcl@${TCL_VERSION}
      prefix: /usr
EOF
    spack config add -f /tmp/tcl_tk_packages.yaml

    # Take the same version of spack-packages as on Roihu (or at least not too different).
    # This won't have all newest recipes for some deps that we want; will fetch those individually later (and fight the concretizer until they build cleanly)
    git clone -b csc/v2026.03 --depth 1 https://github.com/CSCfi/spack-packages.git

    spack repo add spack-packages/repos/spack_repo/builtin

    # Fetch newest upstream package repo
    cd spack-packages
    git remote add upstream https://github.com/spack/spack-packages.git
    # Pin to a reasonably recent commit
    git fetch upstream eaadd8b74d28556d5a8aa293f50160b537f8f963:refs/remotes/upstream/pinned --depth=1

    export LOG_DIR={{ BASEDIR }}/environments/gpaw_deps/logs
    mkdir -p $LOG_DIR

    # Add packages, fetching newer recipes from spack-packages repo when needed.
    # If modifying or adding specs here you MUST look at the concretizer output! There can easily be surprises.
    # For example, Spack can quietly turn off package default flags depending on other specs in the env, your concretizer config and external packages.
    # See:
    # https://docs.csc.fi/support/tutorials/roihu-user-spack/#what-to-do-when-concretization-is-not-using-an-upstream-dependency
    # https://spack.readthedocs.io/en/latest/frequently_asked_questions.html#why-does-spack-pick-particular-versions-and-variants

    # Python with tkinter. Also explicitly enable many "default" modules to force Spack always build with them (see docs above).
    # Build & install it already here with --test=root, this errors out if a module (eg. tkinter) could not be built.
    # Otherwise it would silently continue without the said module. We don't do --test for the other packages in case they'd be expensive.
    cp {{ CONFIG_DIR }}/python_spack_package.py repos/spack_repo/builtin/packages/python/package.py
    spack add python@{{ PYTHON_VER }} +optimizations +tkinter +pyexpat+ctypes+ssl+sqlite3+bz2+lzma+zstd+uuid+readline+dbm+curses ^tk+xft+xss
    spack install --log-format=junit --log-file=$LOG_DIR/install-python.log --show-log-on-error --fail-fast --test=root

    spack add py-numpy@2.4
    spack add py-scipy@1.17

    git checkout upstream/pinned -- repos/spack_repo/builtin/packages/libxc
    spack add libxc@7.1.2+fhc ~fortran
    spack add libvdwxc@0.5.0+mpi

    # elpa@2025.06.001 was apparently bad, so we fetch newer recipes. https://gitlab.com/gpaw/gpaw/-/merge_requests/3226
    git checkout upstream/pinned -- repos/spack_repo/builtin/packages/elpa
    spack add elpa@2026.02.002 +mpi

    # ASE provides wrappers for dftd3/dftd4 but doesn't install them for you
    spack add dftd3-lib@0.10
    spack add dftd4@3.7.0+python ^python@{{ PYTHON_VER }}

    cd {{ BASEDIR }}

    # Concretize and install, storing logs
    spack concretize -f 2>&1 | tee $LOG_DIR/spack-concretize.log
    spack find -v --long --show-full-compiler > $LOG_DIR/spack-concretized-specs.txt
    spack find --long | tee $LOG_DIR/spack-find.log

    spack install --log-format=junit --log-file=$LOG_DIR/install.log --show-log-on-error --fail-fast

    # Write the env setup to a plain script that the %environment block can load.
    # We want to avoid loading the spack env directly (slow!). Instead, set relevant vars point to the spack view
    cat > {{ ENV_SCRIPT }} << 'EOF'
# Activate module environment and load default modules
. /opt/activate.sh
export _SPACK_GPAW_VIEW_DIR={{ VIEW_DIR }}
export PATH={{ VIEW_DIR }}/bin:$PATH
export LIBRARY_PATH={{ VIEW_DIR }}/lib:{{ VIEW_DIR }}/lib64:$LIBRARY_PATH
export LD_LIBRARY_PATH={{ VIEW_DIR }}/lib:{{ VIEW_DIR }}/lib64:$LD_LIBRARY_PATH
export CPATH={{ VIEW_DIR }}/include:$CPATH
# "Patch" for ELPA's weird include path
export CPATH={{ VIEW_DIR }}/include/elpa_openmp-2026.02.002:$CPATH
export PKG_CONFIG_PATH={{ VIEW_DIR }}/lib/pkgconfig:{{ VIEW_DIR }}/lib64/pkgconfig:$PKG_CONFIG_PATH
export MANPATH={{ VIEW_DIR }}/share/man:$MANPATH
EOF

%environment
    . {{ ENV_SCRIPT }}

%runscript
    exec "$@"
