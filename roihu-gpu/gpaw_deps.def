Bootstrap: docker
From: satama.csc.fi/r_installation_spack/core-gpu-gcc-15.2.0-cuda-13.1.1:v2026_03
%post
    # Activate module environment and load default modules from the base container
    . /opt/activate.sh

    mkdir -p /users

    ml gcc/15.2.0
    ml cuda/13.0.2
    ml openmpi/5.0.10
    # Spack prerequisites
    dnf install --assumeyes epel-release
    dnf install --assumeyes file bzip2 ca-certificates git gzip patch python3 tar unzip xz zstd

    # install spack
    git clone --depth 1 --branch v1.2.2 https://github.com/spack/spack.git
    . spack/share/spack/setup-env.sh

    # Create a spack environment and make it aware of packages installed in the base container
    #export SPACK_USER_CACHE_PATH=$TMPDIR/spack
    #export SPACK_DISABLE_LOCAL_CONFIG=true
    source spack/share/spack/setup-env.sh
    source spack/share/spack/bash/spack-completion.bash
    upstream=g15cu131_eg
    spack env create environments/gpaw_deps_${upstream}
    spack env activate -p environments/gpaw_deps_${upstream}

    spack config add upstreams:${upstream}:install_tree:/appl/soft/spack/core/v2026_03/aarch64/${upstream}/install_dir
    spack config add config:install_tree:root:$PWD/gpaw_deps_${upstream}-install
    spack config add config:source_cache:source-cache
    spack config add 'config:install_tree:projections:all:"{name}-{version}-{hash:7}"'

    # All packages should be built for neoverse_v2. Should be automatic if building on Roihu-GPU, but just in case.
    spack config add packages:all:target:[neoverse_v2]

    # get most up-to-date spack packages repo
    git clone --depth 1 https://github.com/spack/spack-packages.git

    spack repo add /spack-packages/repos/spack_repo/builtin

    spack add libxc@7.1.2+fhc
    spack add python@3.14.5
    spack add py-numpy@2.5.1
    spack add py-scipy@1.17.1

    # Cupy spack recipe is annoying since it wants Cython 3.1 but also depends on py-fastrlock which in turn wants Cython 3.0.XX.
    # The following config lets spack "unify" these so that both Cythons are installed.
    spack config add concretizer:unify:when_possible
    spack add py-cupy@14.0.1 +cuda cuda_arch=90a

    spack concretize
    spack install

    # remove unneeded stuff
    rm -rf spack-packages

    # Workaround for spack env activate not working in a read-only filesystem (the container).
    # --sh prints out shell commands that achieve the same result as spack env activate,
    # so we store these in a file and source it in %environment
    spack env activate --sh environments/gpaw_deps_g15c131_eg > environments/gpaw_deps_g15c131_eg/env_activate_cmds.sh

%environment
    . /opt/activate.sh

    ml gcc/15.2.0
    ml cuda/13.0.2
    ml openmpi/5.0.10
    ml openblas/0.3.30
    ml netlib-scalapack/2.2.2
    ml fftw/3.3.10
    # NOTE: if using `apptainer shell`, this block does run but things like bash aliases don't carry over to the final shell.
    # So you may want to activate the env manually in the shell. Envvars should carry over, though

    source /environments/gpaw_deps_g15c131_eg/env_activate_cmds.sh

%runscript
#    . /opt/activate.sh
    exec "$@"
