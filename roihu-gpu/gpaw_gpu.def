Bootstrap: localimage
From: gpaw_gpu_base.sif

%arguments
    BASEDIR=/gpaw_container
    CONFIG_DIR={{ BASEDIR }}/config
    ENV_SCRIPT=/opt/gpaw_deps_env.sh
    # Where the to-be-wrapped executables are put
    TYKKY_BIN_DIR={{ BASEDIR }}/tykky_wrap/bin

    GPAW_VERSION=26.7.0
    ASE_VERSION=3.29.0

%files
    # Copy siteconfig into the container. It can be useful for users too so keep it in a sensible location
    config/gpaw_gpu_siteconfig.py {{ CONFIG_DIR }}/siteconfig.py

%post
    . {{ ENV_SCRIPT }}

    cd /opt

    python -m ensurepip
    python -m pip install --upgrade certifi
    # Should be pip >= 26.2.2, certifi >= 2026.10.19
    python -m pip --version
    python -m pip list | grep certifi

    # Constrain numpy/pip versions
    python -m pip list --format=freeze | grep -E '^(numpy|scipy)' | tee {{ CONFIG_DIR }}/constraints.txt
    PIP_INSTALL="python -m pip install --constraint {{ CONFIG_DIR }}/constraints.txt"

    $PIP_INSTALL pip setuptools packaging --upgrade
    # GPAW 26.7 tests have a bug that is incompatible with pytest >=9.1. Fixed in newer GPAW versions
    $PIP_INSTALL pytest==9.0.3
    $PIP_INSTALL pybind11==3.0.2 --upgrade

    $PIP_INSTALL cupy-cuda13x==14.1.1

    $PIP_INSTALL ase=={{ ASE_VERSION }}
    cd /opt
    git clone --depth=1 -b {{ GPAW_VERSION }} https://gitlab.com/gpaw/gpaw.git
    export GPAW_CONFIG={{ CONFIG_DIR }}/siteconfig.py
    cd gpaw
    # Seems to not install _gpaw .so into correct place if using makefile build. This needs FIXME on GPAW side
    $PIP_INSTALL -v . --no-build-isolation

    cd /opt
    rm -rf gpaw

    # Copy the siteconfig to a convenient location. Can be useful reference for users who want dev installation
    mkdir -p $_SPACK_GPAW_VIEW_DIR/gpaw_utils
    cp $GPAW_CONFIG $_SPACK_GPAW_VIEW_DIR/gpaw_utils/siteconfig.py

    # Tykky setup: symlink just the executables that we'll wrap with tykky into a separate location
    TYKKY_BIN_PATTERNS="ase gpaw* python* dftd3 dftd4"
    mkdir -p {{ TYKKY_BIN_DIR }}
    set -f
    for pattern in $TYKKY_BIN_PATTERNS; do
        find "$_SPACK_GPAW_VIEW_DIR/bin" -maxdepth 1 -name "$pattern" | while read -r exe; do
            ln -s "$exe" {{ TYKKY_BIN_DIR }}
        done
    done
    set +f
    ls {{ TYKKY_BIN_DIR }}

%environment
    . {{ ENV_SCRIPT }}

%runscript
    exec "$@"
