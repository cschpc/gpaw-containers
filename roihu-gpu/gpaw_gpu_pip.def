# Installs some Python packages that are hard to get with Spack, and finally install GPAW

Bootstrap: localimage
From: gpaw_gpu_base.sif

%files
    config/gpaw_gpu_siteconfig.py /opt/gpaw_deps_config/siteconfig.py

%post
    . /opt/gpaw_deps_env.sh

    cd /opt

    # Get pip and update it to a safe version, then get safe version of certifi. This is a patch for compromised eMudhra certificates,
    # https://discuss.python.org/t/information-for-python-users-regarding-emudhra-emsign-ca-certificate-security-incident/109576.
    # Can be removed in the future once ensurepip starts giving a safe version out of the box
    python -m ensurepip
    python -m pip install "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
    python -m pip install --upgrade certifi
    # Should be pip >= 26.2.2, certifi >= 2026.10.19
    python -m pip --version
    python -m pip list | grep certifi

    python -m pip install setuptools packaging --upgrade

    python -m pip install cupy-cuda13x==14.1.1

    # install ASE and GPAW and any additional deps for them
    python -m pip install pybind11==3.0.1
    python -m pip install ase==3.29.0

    git clone --depth=1 --branch 26.7.0 https://gitlab.com/gpaw/gpaw.git
    export GPAW_CONFIG=/opt/gpaw_deps_config/siteconfig.py
    cd gpaw
    python -m pip install -v . --no-build-isolation
    cd ..

    # cleanup
    rm -rf /opt/gpaw

    # Tykky setup: symlink just the executables that we'll wrap with tykky into a separate location
    TYKKY_BIN_PATTERNS="ase gpaw* python* pytest dftd3 dftd4"
    TYKKY_BIN_DIR=/opt/tykky_wrap/bin
    mkdir -p "$TYKKY_BIN_DIR"
    set -f
    for pattern in $TYKKY_BIN_PATTERNS; do
        find "$_SPACK_GPAW_VIEW_DIR/bin" -maxdepth 1 -name "$pattern" | while read -r exe; do
            ln -s "$exe" "$TYKKY_BIN_DIR"
        done
    done
    set +f
    ls "$TYKKY_BIN_DIR"

%environment
    . /opt/gpaw_deps_env.sh

%runscript
    exec "$@"
